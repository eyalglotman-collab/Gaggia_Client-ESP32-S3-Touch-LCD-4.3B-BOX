flowchart TD
    subgraph RESET["RESET"]
        R1["Host sends RESET(profile or parameters)"] --> R2["Bridge clears counters and buffers"]
        R2 --> R3["Bridge runs self-test"]
        R3 --> R4["Bridge returns RESET_ACK"]
    end

    subgraph INITIALIZE["INITIALIZE"]
        I1["Host sends INITIALIZE(role, endpoint, watchdog)"] --> I2["Bridge validates configuration"]
        I2 --> I3["Bridge ensures Wi-Fi hardware stack is ready"]
        I3 --> I4["Bridge runs SSID visibility precheck scan"]
        I4 --> I5["Bridge prepares Wi-Fi/TCP resources only when target SSID is visible"]
        I5 --> I6["Bridge returns INITIALIZE_ACK"]
    end

    subgraph CONNECT["CONNECT"]
        C1["Host sends CONNECT"] --> C2["Bridge opens/accepts low-level session"]
        C2 --> C3["Bridge returns CONNECT_ACK"]
        C3 --> C4["Client waits for first valid keepalive to prove synchronized session"]
    end

    subgraph KEEPALIVE["KEEPALIVE"]
        K1["ESP32-C3 server sends KEEPALIVE with current ServerLiveInteger"] --> K2["ESP32-S3 client validates ServerLiveInteger and increments ClientLiveInteger"]
        K2 --> K3["ESP32-S3 client returns KEEPALIVE with the new ClientLiveInteger"]
        K3 --> K4["ESP32-C3 server validates ClientLiveInteger, increments ServerLiveInteger, and sends the next KEEPALIVE"]
        K4 --> K5["Client clears ConnectionFault after successful keepalive exchange"]
    end

    subgraph DATA["DATA"]
        P1["Upper layer sends DATA payload"] --> P2["Low-level layer validates framing and CRC"]
        P2 --> P3["Validated downlink payload is enqueued into DATA downlink FIFO (depth 64)"]
        P3 --> P4["If FIFO is full, enqueue waits (delay/back-pressure, no client-side drop)"]
        P4 --> P5["UI poll timer (20 ms) pops one packet per tick in FIFO order"]
        P5 --> P6["Simulate Data chart updates once per popped packet"]
        P6 --> P7["Peer returns DATA response or ACK"]
    end

    subgraph RETRY["RETRY / CONNECTION FAULT"]
        E1["Keepalive failure closes the socket and returns the client to CONNECT"] --> E2["Sequential keepalive-failure counter increments"]
        E2 --> E3["After 5 sequential failures the client latches ConnectionFault and enters WaitForComReset"]
        E3 --> E4["UI banner shows reset-required fault state until Reset Connection is pressed"]
    end

    subgraph SCAN["SCAN"]
        S1["Operator presses Scan for Devices"] --> S2["Connection Info text box is cleared immediately"]
        S2 --> S3["communication_functions_request_scan() queues scan workflow"]
        S3 --> S4["Wi-Fi driver runs AP discovery for 10 seconds"]
        S4 --> S5["Communication task reads AP records and formats scan_results"]
        S5 --> S6["Connection Info text box shows discovered device list"]
    end
